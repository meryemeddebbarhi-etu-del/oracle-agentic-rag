# Oracle Database (garde ici les identifiants Oracle de l'équipe)
ORACLE_USER=vector
ORACLE_PWD=CHANGE_ME
ORACLE_DSN=localhost:1521/FREEPDB1

# Recherche : mock pour essayer l'agent sans Oracle, real pour la recherche Oracle du membre 2
SEARCH_BACKEND=mock
DEFAULT_SEARCH_METHOD=auto
DEFAULT_TOP_K=5

# LLM : Groq demande une clé API; fake fonctionne hors ligne en mode direct
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0

# Alternative optionnelle si vous utilisez OpenAI API (facturation distincte de ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
